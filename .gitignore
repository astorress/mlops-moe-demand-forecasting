# =====================================================
# DATA FOLDERS (se regeneran con notebooks)
# Ignora archivos pero mantiene carpetas con .gitkeep
# =====================================================
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/classifiers/*
!data/classifiers/.gitkeep
data/clustering/*
!data/clustering/.gitkeep

# =====================================================
# MODELS FOLDERS (se entrenan con notebooks)
# Ignora archivos pero mantiene carpetas con .gitkeep
# =====================================================
models/classifiers/*
!models/classifiers/.gitkeep
models/experts/*
!models/experts/.gitkeep
models/gating/*
!models/gating/.gitkeep
models/hyperparameters/*
!models/hyperparameters/.gitkeep
models/production/*
!models/production/.gitkeep
models/production/experts/*
!models/production/experts/.gitkeep

# =====================================================
# RESULTS FOLDERS (se generan en ejecución)
# Ignora archivos pero mantiene carpetas con .gitkeep
# =====================================================
results/*
!results/.gitkeep
!results/benchmark/
results/benchmark/*
!results/benchmark/.gitkeep

# Tipos de archivo específicos a ignorar
*.parquet
*.pkl
*.joblib
*.png
*.jpg
*.jpeg
*.gif
*.csv
*.tmp

